rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Qui est qui ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isSuper() {
      return signedIn() && (
        me() in ['JJj2RolSbmVlWc3n4qT6NvAhxZ63']
        || exists(/databases/$(database)/documents/admins/$(me())));
    }
    function staffPath() { return /databases/$(database)/documents/staff/$(me()); }
    function isStaff() {
      return signedIn() && exists(staffPath())
        && get(staffPath()).data.get('active', true) == true;
    }
    function staffShop() { return get(staffPath()).data.shopId; }
    function isStaffOf(shopId) { return isStaff() && staffShop() == shopId; }
    function isManagerOf(shopId) {
      return isStaffOf(shopId) && get(staffPath()).data.role == 'manager';
    }
    // Permission d'un agent (un responsable a tout).
    function canIn(shopId, perm) {
      return isStaffOf(shopId) && (
        get(staffPath()).data.role == 'manager'
        || get(staffPath()).data.get('perms', {}).get(perm, false) == true);
    }
    function manages(shopId) { return isSuper() || isStaffOf(shopId); }
    function isManager() {
      return isStaff() && get(staffPath()).data.role == 'manager';
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function conv(cid) {
      return /databases/$(database)/documents/conversations/$(cid);
    }

    // ---------- Comptes ----------
    // Super Admins (le Super Admin principal peut nommer un compte de secours).
    match /admins/{uid} {
      allow read: if signedIn() && (me() == uid || isSuper());
      allow create, delete: if isSuper();
      allow update: if false;
    }

    // Profils : un agent ne voit que les clients de SA boutique ;
    // un responsable peut chercher un numéro (pour ajouter un agent).
    match /users/{uid} {
      allow get: if signedIn() && (
        me() == uid || isSuper() || isManager()
        || isStaffOf(resource.data.get('shopId', 'main')));
      allow list: if signedIn() && (
        isSuper() || isManager() || isStaffOf(resource.data.shopId));
      allow create, update: if signedIn() && me() == uid;
    }

    // Équipe : le Super Admin nomme tout le monde ; un responsable gère
    // uniquement les agents de sa boutique.
    match /staff/{uid} {
      // Collègues de la même boutique visibles (pour transférer une discussion).
      allow read: if signedIn() && (
        me() == uid || isSuper() || isStaffOf(resource.data.shopId));
      allow create, update: if isSuper() || (
        isManagerOf(request.resource.data.shopId)
        && request.resource.data.role == 'agent'
        && uid != me()
        && (resource == null || resource.data.shopId == staffShop()));
      allow delete: if isSuper() || (
        isManagerOf(resource.data.shopId) && resource.data.role == 'agent');
    }

    // ---------- Boutiques et paramètres ----------
    match /shops/{shopId} {
      allow read: if true;
      allow create, delete: if isSuper();
      allow update: if isSuper() || (
        isManagerOf(shopId)
        && onlyChanges(['phone', 'whatsapp', 'address', 'hours', 'deliveryFee']));
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isSuper();
    }

    // ---------- Catalogue et offres ----------
    match /catalog/{id} {
      allow read: if true;
      allow create: if isSuper() || canIn(request.resource.data.shopId, 'catalog');
      allow update: if isSuper()
        || (canIn(resource.data.get('shopId', 'main'), 'catalog')
            && request.resource.data.shopId == resource.data.get('shopId', 'main'))
        // Un client peut seulement réserver des places de formation.
        // Un client réserve des places UNIQUEMENT en créant sa commande
        // (même opération) : impossible de bloquer une formation sans commander.
        || (signedIn()
            && onlyChanges(['booked', 'lastOrderId'])
            && request.resource.data.booked is int
            && request.resource.data.booked > resource.data.get('booked', 0)
            && request.resource.data.booked - resource.data.get('booked', 0) <= 50
            && (resource.data.get('places', 0) == 0
                || request.resource.data.booked <= resource.data.places)
            && !exists(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId))
            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId))
                 .data.buyerId == me());
      allow delete: if isSuper() || canIn(resource.data.get('shopId', 'main'), 'catalog');
    }

    match /promotions/{id} {
      allow read: if true;
      allow create: if isSuper() || (
        request.resource.data.shops.size() == 1
        && canIn(request.resource.data.shops[0], 'promos'));
      allow update, delete: if isSuper() || (
        resource.data.shops.size() == 1
        && canIn(resource.data.shops[0], 'promos')
        && (request.resource == null
            || request.resource.data.shops == resource.data.shops));
    }

    match /notifications/{id} {
      allow read: if isSuper() || isStaff();
      allow create: if isSuper() || isStaff();
      allow update, delete: if isSuper();
    }

    // ---------- Commandes ----------
    // Compteurs des numéros AS-00001 / AS-DJD-00001 (augmentent de 1).
    match /counters/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.next == 1;
      allow update: if signedIn() && request.resource.data.next == resource.data.next + 1;
    }

    match /orders/{id} {
      // resource == null : vérifier qu'une commande renvoyée après une coupure
      // n'a pas déjà été créée (pas de doublon).
      allow get: if signedIn() && (
        resource == null
        || resource.data.buyerId == me() || manages(resource.data.get('shopId', 'main')));
      allow list: if signedIn() && (
        resource.data.buyerId == me() || manages(resource.data.shopId));

      allow create: if signedIn()
        && request.resource.data.buyerId == me()
        && request.resource.data.shopId is string
        && request.resource.data.status == 'nouvelle'
        && request.resource.data.paymentStatus == 'en_attente'
        && request.resource.data.total is int
        && request.resource.data.subtotal is int
        && request.resource.data.deliveryFee is int
        && request.resource.data.subtotal >= 0
        && request.resource.data.deliveryFee >= 0
        && request.resource.data.total
             == request.resource.data.subtotal + request.resource.data.deliveryFee
        && request.resource.data.number is string
        && !('quotedTotal' in request.resource.data);

      allow update: if signedIn() && (
        // Super Admin ou équipe autorisée : statut, prix final, message
        ((isSuper() || canIn(resource.data.get('shopId', 'main'), 'status')
                    || canIn(resource.data.get('shopId', 'main'), 'quotes'))
          && onlyChanges(['status', 'quotedTotal', 'adminNote', 'updatedAt',
                          'handledBy', 'handledByName'])
          && request.resource.data.status in
               ['nouvelle', 'confirmee', 'en_cours', 'prete', 'livree', 'annulee'])
        ||
        // Le client peut annuler une commande pas encore traitée
        (resource.data.buyerId == me()
          && resource.data.status == 'nouvelle'
          && onlyChanges(['status', 'updatedAt'])
          && request.resource.data.status == 'annulee')
      );
    }

    // ---------- Discussions ----------
    // L'équipe voit une discussion : Super Admin, responsable de la boutique,
    // ou agent à qui elle est attribuée (ou pas encore attribuée).
    function staffSees(d) {
      return isSuper()
        || isManagerOf(d.get('shopId', 'main'))
        || (isStaffOf(d.get('shopId', 'main'))
            && d.get('assignedTo', '') in [me(), '']);
    }

    match /conversations/{cid} {
      allow get: if signedIn() && (
        resource == null || resource.data.clientId == me()
        || staffSees(resource.data));
      allow list: if signedIn() && (
        resource.data.clientId == me()
        || isSuper()
        || isManagerOf(resource.data.shopId)
        || (isStaffOf(resource.data.shopId)
            && (resource.data.assignedTo == me() || resource.data.assignedTo == '')));
      allow create: if signedIn() && (
        request.resource.data.clientId == me()
        || manages(request.resource.data.shopId));
      allow update: if signedIn() && (
        staffSees(resource.data)
        || (resource.data.clientId == me()
            && onlyChanges(['lastMessage', 'lastAt', 'unreadForShop',
                            'unreadForClient', 'shopId', 'assignedTo', 'assignedName'])
            && request.resource.data.get('assignedTo', '')
                 == resource.data.get('assignedTo', '')));
      allow delete: if isSuper();

      match /messages/{mid} {
        allow read: if signedIn() && (
          !exists(conv(cid))
          || get(conv(cid)).data.clientId == me()
          || staffSees(get(conv(cid)).data));
        allow create: if signedIn() && (
          (staffSees(getAfter(conv(cid)).data)
            && request.resource.data.senderRole == 'shop')
          || (getAfter(conv(cid)).data.clientId == me()
              && request.resource.data.senderId == me()
              && request.resource.data.senderRole == 'client'
              && !('agentName' in request.resource.data)));
        allow update, delete: if false;
      }
    }

    // ---------- Fichiers ----------
    match /files/{id} {
      // Un agent ne voit pas les fichiers des discussions de ses collègues.
      allow read: if signedIn() && (
        resource.data.ownerId == me() || isSuper()
        || isManagerOf(resource.data.get('shopId', 'main')));
      allow create: if signedIn() && request.resource.data.ownerId == me();
      allow update: if false;
      allow delete: if signedIn() && (
        resource.data.ownerId == me() || isSuper());
    }

    // ---------- Contenu des fichiers (découpé en morceaux) ----------
    function blob(id) { return /databases/$(database)/documents/blobs/$(id); }
    function canReadBlob(d) {
      return d.ownerId == me()
        || isSuper()
        || isManagerOf(d.get('shopId', 'main'))
        || get(conv(d.conversationId)).data.clientId == me()
        || staffSees(get(conv(d.conversationId)).data);
    }
    match /blobs/{id} {
      allow get: if signedIn() && canReadBlob(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.size <= 15728640;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.ownerId == me() || isSuper());

      match /chunks/{c} {
        allow read: if signedIn() && canReadBlob(get(blob(id)).data);
        allow create: if signedIn() && getAfter(blob(id)).data.ownerId == me();
        allow update, delete: if false;
      }
    }

    // ---------- Notifications dans l'application (cloche) ----------
    match /inbox/{id} {
      allow get: if signedIn() && (
        resource.data.get('toUid', '') == me()
        || (resource.data.audience == 'staff'
            && manages(resource.data.get('shopId', 'main'))));
      allow list: if signedIn() && (
        resource.data.toUid == me()
        || (resource.data.audience == 'staff' && manages(resource.data.shopId)));
      // Un client ne peut écrire QUE à l'équipe (jamais dans la cloche
      // d'un autre client) : pas de fausses notifications.
      allow create: if signedIn() && request.resource.data.fromUid == me()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 150
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 600
        && (isSuper() || isStaff()
            || request.resource.data.audience in ['staff', 'member']);
      allow update: if false;
      allow delete: if isSuper() || (signedIn() && resource.data.get('toUid', '') == me());
    }

    // ---------- Appels par internet ----------
    function callDoc(id) { return /databases/$(database)/documents/calls/$(id); }
    match /calls/{id} {
      allow get: if signedIn() && (
        resource.data.clientId == me() || manages(resource.data.get('shopId', 'main')));
      allow list: if signedIn() && (
        resource.data.clientId == me() || manages(resource.data.shopId));
      allow create: if signedIn()
        && request.resource.data.callerId == me()
        && request.resource.data.status == 'ringing'
        && (request.resource.data.clientId == me()
            || manages(request.resource.data.shopId));
      allow update: if signedIn() && (
        resource.data.clientId == me() || manages(resource.data.get('shopId', 'main')));
      allow delete: if isSuper();

      match /candidates/{c} {
        allow read, create: if signedIn() && (
          get(callDoc(id)).data.clientId == me()
          || manages(get(callDoc(id)).data.get('shopId', 'main')));
        allow update, delete: if false;
      }
    }

    // Mots de passe oubliés : demande possible sans être connecté
    // (champs limités), lecture et traitement par le Super Admin seulement.
    match /resetRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['phone', 'name', 'message', 'status', 'createdAt'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 300
        && request.resource.data.status == 'en_attente';
      allow read, update, delete: if isSuper();
    }

    // Présence de l'équipe (pour transférer un appel si l'agent est absent)
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid;
    }

    match /payments/{id} {
      allow read, write: if false;
    }
  }
}
